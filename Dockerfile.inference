# Stage 1: Build dependencies
FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim
WORKDIR /app

# Copy only installed packages and source code
COPY --from=builder /root/.local /root/.local
COPY src/model.py src/app.py ./

# Copy model if it exists (optional at build time)
# The model can also be mounted at runtime via volume
COPY final_model.pth* ./

ENV PATH=/root/.local/bin:$PATH
ENV MODEL_PATH=final_model.pth
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]