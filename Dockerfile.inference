# Inference Dockerfile with UV for fast installs
# Stage 1: Build dependencies
FROM python:3.11-slim AS builder

# Install uv
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app
COPY requirements.txt .

# Install to a virtual environment we can copy
RUN uv venv /opt/venv
RUN uv pip install --python /opt/venv/bin/python --no-cache -r requirements.txt

# Stage 2: Runtime (slim image)
FROM python:3.11-slim
WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy only necessary source files
COPY src/model.py src/app.py ./

# Copy model if it exists (optional at build time)
COPY final_model.pth* ./

ENV MODEL_PATH=final_model.pth
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]